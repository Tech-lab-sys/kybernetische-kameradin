{
  "name": "Email Triage",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "limit": 10,
        "filters": {
          "q": "is:unread"
        }
      },
      "name": "Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [450, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmailOAuth2",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "1",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "IF Emails Exist",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "prompt": "Du bist ein intelligenter Assistent. Fasse die folgende E-Mail zusammen und bewerte ihre Priorität (Hoch, Mittel, Niedrig). Antworte auf Deutsch in folgendem Format:\n\nPriorität: [Priorität]\nZusammenfassung: [Zusammenfassung]\n\nE-Mail Betreff: {{$json.snippet}}\nE-Mail Inhalt: {{$json.textPlain}}"
      },
      "name": "LLM Summary",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [850, 300]
    },
    {
      "parameters": {
        "model": "gemini-2.5-flash"
      },
      "name": "Google Gemini Model",
      "type": "@n8n/n8n-nodes-langchain.lmGoogleGemini",
      "typeVersion": 1,
      "position": [850, 500],
      "credentials": {
        "googlePalmApi": {
          "id": "googlePalmApi",
          "name": "Google Gemini API key"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.text }}",
        "additionalFields": {}
      },
      "name": "Telegram Notification",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1050, 300],
      "credentials": {
        "telegramApi": {
          "id": "telegramApi",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Gmail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail": {
      "main": [
        [
          {
            "node": "IF Emails Exist",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Emails Exist": {
      "main": [
        [
          {
            "node": "LLM Summary",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Google Gemini Model": {
      "ai_languageModel": [
        [
          {
            "node": "LLM Summary",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "LLM Summary": {
      "main": [
        [
          {
            "node": "Telegram Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "f789d31d-b8d9-43df-ab64-8848d5d470d0"
}
